{
  "name": "eslint-plugin-svelte-sort-attributes",
  "type": "module",
  "version": "1.3.0",
  "author": "Miquel de Domingo",
  "license": "MIT",
  "homepage": "https://github.com/mikededo/eslint-plugin-svelte-sort-attributes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikededo/eslint-plugin-svelte-sort-attributes.git"
  },
  "bugs": "https://github.com/mikededo/eslint-plugin-svelte-sort-attributes/issues",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "svelte"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run --coverage"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "svelte": ">=3.0.0",
    "svelte-eslint-parser": ">=1.1.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@typescript-eslint/types": "^8.55.0",
    "@typescript-eslint/utils": "^8.55.0",
    "minimatch": "^10.0.3",
    "natural-compare-lite": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@changesets/cli": "2.29.7",
    "@svitejs/changesets-changelog-github-compact": "1.2.0",
    "@types/natural-compare-lite": "1.4.2",
    "@types/node": "24.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "ajv": "8.17.1",
    "eslint-plugin-perfectionist": "^5.5.0",
    "ts-dedent": "2.2.0",
    "vite": "7.1.7",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.4"
  }
}
